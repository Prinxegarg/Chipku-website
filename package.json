{
  "name": "chipku-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:content": "node --experimental-strip-types scripts/check-content.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "docs:sheets": "node --experimental-strip-types scripts/sheet-docs.ts",
    "typecheck": "tsc --noEmit -p .",
    "functions:dev": "wrangler pages dev dist",
    "check": "npm run typecheck && npm test && npm run check:content"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.56.1",
    "typescript": "6.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
