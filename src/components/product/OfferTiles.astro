---
import { activeOffers, tierNeed } from '../../lib/offers.ts';
import { formatMoney } from '../../lib/money.ts';
import type { Catalog, ProductType } from '../../lib/types.ts';

interface Props {
  catalog: Catalog;
  eligible: boolean;
  productType: ProductType;
}
const { catalog, eligible, productType } = Astro.props;
const offers = activeOffers(catalog.offers);
const elig = offers.buyGetEligibility;
const noun: Record<string, string> = { poster: 'posters', sticker: 'stickers', polaroid: 'photo prints' };
const what = elig.productTypes.length === 1 ? noun[elig.productTypes[0]] : 'items';
const browse = elig.productTypes.length === 1 ? { poster: '/posters', sticker: '/stickers', polaroid: '/photo-prints' }[elig.productTypes[0]] : '/shop';
const spend = offers.spend;
const show = offers.buyGet.length > 0 || spend;
---

{
  show && (
    <section class="pdp-offers" aria-labelledby="pdp-offers-title" data-pdp-offers>
      <h2 class="pdp-offers__title" id="pdp-offers-title">
        Offers
      </h2>
      {offers.buyGet.length > 0 &&
        (eligible ? (
          <>
            <p class="pdp-offers__lead">
              Choose more {what} and some are on us — “Get” means extra free {what}. Pick a goal to track it in your cart.
            </p>
            <ul class="offer-tiles" role="list">
              {offers.buyGet.map((t) => (
                <li class="offer-tile" data-tile={t.id} data-starts={t.startsAt} data-ends={t.endsAt}>
                  <button type="button" class="offer-tile__btn" aria-pressed="false" data-goal={t.id}>
                    <span class="offer-tile__head">{t.label}</span>
                    <span class="offer-tile__desc">
                      Choose {tierNeed(t)} eligible {what} · pay for {t.paid}
                    </span>
                  </button>
                  <a class="offer-tile__link" href={browse}>
                    Browse eligible {what}
                  </a>
                </li>
              ))}
            </ul>
            <p class="pdp-offers__status" data-goal-status aria-live="polite" />
          </>
        ) : (
          <p class="pdp-offers__note">
            This {productType === 'polaroid' ? 'photo print' : productType} doesn't count towards the Buy/Get offers on {what}.
          </p>
        ))}
      {spend && (
        <p class="pdp-offers__spend">
          <strong>{spend.label}</strong>
          {offers.buyGet.length > 0 ? ' — combines with Buy/Get offers.' : '.'}
          <span class="muted"> Worked out on your eligible total after Buy/Get savings{spend.operator === 'gt' ? `; exactly ${formatMoney(spend.threshold)} doesn't qualify` : ''}.</span>
        </p>
      )}
      <button type="button" class="pdp-offers__details" data-open-offers aria-haspopup="dialog">
        Offer details
      </button>
    </section>
  )
}
