---
import SectionHead from '../ui/SectionHead.astro';
import { icons, jsonForScript } from '../../lib/render/html.ts';
import type { Catalog } from '../../lib/types.ts';

interface Props {
  catalog: Catalog;
}
const { catalog } = Astro.props;
const preview = catalog.mode === 'preview';
const products = new Map(catalog.products.map((p) => [p.id, p]));
// Only reviews supplied in the Reviews sheet (approved + permission). Never invented.
const reviews = catalog.reviews.slice(0, 16);
const placeholders = preview && reviews.length === 0 ? 6 : 0;
const LONG = 180;
const fmtDate = (d?: string) =>
  d ? new Date(`${d}T00:00:00+05:30`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
---

{
  (reviews.length > 0 || placeholders > 0) && (
    <section class="section reviews" aria-labelledby="rev-title" data-reviews>
      <div class="wrap">
        <SectionHead
          id="rev-title"
          title="From the CHIPKU community."
          highlight="community."
          sub={preview && reviews.length === 0 ? 'Customer photos and reviews from the Reviews sheet appear here.' : 'Real walls, real words — shared with permission.'}
        />
      </div>
      <div class="reviews__viewport" data-marquee-viewport>
        <ul class="reviews__track" role="list" data-marquee-track>
          {reviews.map((r) => {
            const product = r.productId ? products.get(r.productId) : undefined;
            const long = r.body.length > LONG;
            return (
              <li class="review-card" data-review={r.id}>
                {r.media[0] && (
                  <button type="button" class="review-card__photo" data-review-open={r.id} aria-label={`View photo from ${r.displayName}`}>
                    <img src={r.media[0].url} alt={r.media[0].alt} width="480" height="600" loading="lazy" decoding="async" data-media />
                  </button>
                )}
                <div class="review-card__body">
                  {r.rating && (
                    <p class="review-card__stars">
                      <span class="stars" style={`--pct:${(r.rating / 5) * 100}%`} aria-hidden="true" />
                      <span class="sr-only">Rated {r.rating} out of 5</span>
                    </p>
                  )}
                  {r.title && <p class="review-card__title">{r.title}</p>}
                  <p class="review-card__text">{long ? `${r.body.slice(0, LONG).trimEnd()}…` : r.body}</p>
                  {long && (
                    <button type="button" class="review-card__more" data-review-open={r.id}>
                      Read more<span class="sr-only"> of {r.displayName}'s review</span>
                    </button>
                  )}
                  <p class="review-card__by">
                    <strong>{r.displayName}</strong>
                    {r.verified && <span class="badge badge--line">Verified purchase</span>}
                  </p>
                  <p class="review-card__meta">
                    {product && (
                      <a href={`/products/${product.slug}`}>{product.title}</a>
                    )}
                    {product && r.date && ' · '}
                    {r.date && <time datetime={r.date}>{fmtDate(r.date)}</time>}
                  </p>
                </div>
              </li>
            );
          })}
          {Array.from({ length: placeholders }, (_, i) => (
            <li class="review-card review-card--ph" aria-label="Review placeholder">
              <div class="review-card__photo review-card__photo--ph">
                <span class="ph__label">Review photo {i + 1}</span>
              </div>
              <div class="review-card__body">
                <span class="ph-line" style="width:92%" />
                <span class="ph-line" style="width:78%" />
                <span class="ph-line" style="width:56%" />
                <p class="review-card__meta">Customer review — supplied later</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="wrap reviews__controls">
        <button type="button" class="btn btn--sm btn--secondary" data-marquee-toggle aria-pressed="false" hidden>
          <span class="reviews__pause" set:html={icons.pause} />
          <span class="reviews__play" set:html={icons.play} />
          <span data-marquee-label>Pause reviews</span>
        </button>
      </div>
      {reviews.length > 0 && (
        <script type="application/json" data-review-data set:html={jsonForScript(
          reviews.map((r) => ({ id: r.id, name: r.displayName, body: r.body, title: r.title, rating: r.rating, media: r.media, date: fmtDate(r.date), product: r.productId ? products.get(r.productId)?.title : undefined }))
        )} />
      )}
    </section>
  )
}

{
  reviews.length > 0 && (
    <dialog class="modal review-dialog" id="review-dialog" aria-labelledby="review-dialog-title">
      <div class="modal__head">
        <h2 class="modal__title" id="review-dialog-title" tabindex="-1">Review</h2>
        <button type="button" class="icon-btn" data-close aria-label="Close review" set:html={icons.close} />
      </div>
      <div class="modal__body" data-review-dialog-body />
    </dialog>
  )
}

<script>
  import '../../client/reviews.ts';
</script>
